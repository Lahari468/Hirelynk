# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hirelynk

# JWT Configuration
JWT_SECRET=your_secret_key_here_minimum_32_characters_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_32_characters_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d